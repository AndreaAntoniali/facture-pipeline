# Copier en .env puis remplir (le .env n'est jamais commité).

# Bucket S3 des factures (identifiants fournis par l'enseignant)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=https://dams-5.s3-gateway.console.hyperfluid.cloud
AWS_DEFAULT_REGION=default
S3_BUCKET=factures
S3_PREFIX=

# Zone d'arrivée des PDF
OUT_DIR=data/landing/factures

# OCR LightOnOCR-3 sur Hyperfluid (clé d'API créée depuis la console)
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=
